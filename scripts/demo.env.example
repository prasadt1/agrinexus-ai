# Copy to demo.env and fill in your values. Scripts auto-load demo.env when present.
# Do not commit demo.env (it contains secrets).

# Required for webhook-based tests (e2e-test, reset-onboard-and-demo, demo-nudge-flow, etc.)
WEBHOOK_URL="https://YOUR_API_ID.execute-api.us-east-1.amazonaws.com/dev/webhook"
APP_SECRET="your_whatsapp_app_secret"

# Your test WhatsApp number (E.164, e.g. +919876543210)
PHONE_NUMBER="+919876543210"

# Optional: DynamoDB table and region (defaults: agrinexus-data, us-east-1)
# TABLE_NAME="agrinexus-data"
# AWS_REGION="us-east-1"

# Optional: for reset-onboard-and-demo / e2e-test
# WEATHER_LAMBDA="agrinexus-weather-dev"
